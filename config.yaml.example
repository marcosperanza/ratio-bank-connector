# Bank Connector configuration
# Copy to config/config.yaml and fill in your values.
# Run `bank-connector setup` to generate this interactively.

enable_banking:
  app_id: "your-app-id-from-enablebanking-portal"
  private_key_path: "./config/eb-private-key.pem"
  # Alternative: inline PEM as base64
  # private_key_b64: "LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tL..."

sync:
  interval_hours: 6       # max 4 calls/day per bank — 6h keeps you under the limit
  lookback_days: 30       # first sync fetches this many days back
  csv_dir: "./data"       # local CSV storage directory
  archive_mode: "csv_and_raw" # off | csv | csv_and_raw; managed mode defaults to off

ratio:
  enabled: false          # set to true to push encrypted transactions to Ratio
  url: "https://app.ratioapp.it"
  connector_token: ""     # generated by `bank-connector setup` or `POST /api/connector/auth`
  # Keys below are generated by `bank-connector setup` — do not edit manually
  encrypted_master_key: ""
  master_key_iv: ""
  encrypted_search_key: ""

# Add accounts after running `bank-connector link`
accounts:
  - eb_account_id: "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
    ratio_workspace_id: "your-workspace-cuid"  # from Ratio dashboard or `setup` output
  # - eb_account_id: "YYYYYYYY-YYYY-YYYY-YYYY-YYYYYYYYYYYY"
  #   ratio_workspace_id: "another-workspace-cuid"
